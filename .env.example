# Variáveis do ambiente local (Docker Compose).
# Copie para .env e ajuste os valores:  cp .env.example .env
# O arquivo .env não é versionado.

# Nome do ambiente exibido em /api/info e na página inicial
APP_ENV=local

# Porta da API no seu computador (http://localhost:8080)
API_PORT=8080

# Banco PostgreSQL do container "db"
POSTGRES_DB=movesaude
POSTGRES_USER=movesaude
POSTGRES_PASSWORD=troque-esta-senha

# Schema onde o Flyway cria as tabelas
DB_SCHEMA=movesaude

# ---------------------------------------------------------------------------
# Staging e produção (Render + Supabase) usam as mesmas variáveis da aplicação,
# configuradas no painel do Render (os valores reais não ficam no repositório):
#   APP_ENV=staging | production
#   DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USER=movesaude_staging.<project-ref>   | movesaude_producao.<project-ref>
#   DB_PASSWORD=<senha do usuário do ambiente>
#   DB_SCHEMA=movesaude_staging               | movesaude_producao
